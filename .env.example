# APEX Gemini Proxy Configuration

# Required: Your Google Gemini API Key
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use
# Default: gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# Optional: Server port
# Default: 8787
PORT=8787

# Optional: CORS allowed origins
# Comma-separated list of origins, or * for all
# Default: *
CORS_ORIGIN=*

# Optional: Rate limiting
# Default: 60 requests per 60000ms (1 minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Optional: Node environment (development or production)
# Default: development
NODE_ENV=development
